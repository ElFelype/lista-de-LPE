#include <stdio.h>
#define Tam 3
 /*
Três baterias de 12V estão ligadas em série. Solicite ao usuário a tensão que cada uma 
consegue fornecer (em volts) e calcule a tensão total do sistema
*/
int main(void)
{
    float tesao[Tam];
    float soma = 0;
    for(int i = 0; i<Tam;i++){
        printf("Coloque a tensão do componente %d: ", i + 1);
        scanf("%f", &tesao[i]);
        
        soma += tesao[i];
    }
    printf("A tesao total é de %.2f", soma);
   return 0;
}
