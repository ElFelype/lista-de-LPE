#include <stdio.h>
/*
Escreva um programa que solicite ao usuário a potência (em watts) de um chuveiro
elétrico e o tempo médio diário de uso (em horas). O programa deve calcular e exibir o
consumo mensal em kWh, considerando 30 dias.
*/

int main(void)
{
    float potencia;
    float horas;

    printf("Digite a potência do chuveiro e as horas usada: ");
    scanf("%f %f" , &potencia, &horas);

      
    float consumo = (potencia * horas * 30) / 1000.0;

    printf("\nConsumo mensal estimado: %.2f kWh\n", consumo);

    return 0;
}
