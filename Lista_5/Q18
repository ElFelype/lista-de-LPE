#include <stdio.h>

#define N 3

/*
Transposta de matriz: Calcular in-place e exibir a matriz resultante.
*/
int main(void)
{
    int matriz[N][N] = {
        {3,  4, 6},
        {7,  4, 2},
        {8, 10, 9}
    };

    // 1. Transposição in-place (percorre apenas o triângulo superior)
    for (int i = 0; i < N; i++) {
        for (int j = i + 1; j < N; j++) {
            int temp = matriz[i][j];
            matriz[i][j] = matriz[j][i];
            matriz[j][i] = temp;
        }
    }

    // 2. Exibição da matriz completa transposta
    printf("Matriz Transposta (%dx%d):\n", N, N);
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            printf("%3d ", matriz[i][j]);
        }
        printf("\n"); // Quebra de linha ao fim de cada linha da matriz
    }

    return 0;
}
