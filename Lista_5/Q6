#include <stdio.h>
#define TAM 10
/*
Ordem inversa: Ler um vetor e imprimir seus elementos na ordem inversa
*/    
int main(void)
{
    int vetor[TAM] = {1,2,54,6,0,7,3,8,9,4};
    int *ptr = &vetor[TAM-1];
    

    for(int i = 0; i<TAM; i++){
        printf("%d ", *ptr);
        *(ptr--);
    }
    
}
