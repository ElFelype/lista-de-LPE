#include <stdio.h>
#include <stdlib.h>

int main(void)
{
    int quant_dados;
    int soma_vet = 0;

    printf("Coloque a quantidade de dados que quer somar: ");
    scanf("%d", &quant_dados);

    if (quant_dados <= 0) {
        printf("Quantidade invalida.\n");
        return 1;
    }

    
    int *vetor = (int *)malloc(quant_dados * sizeof(int));
    if (vetor == NULL) {
        printf("ERRO de alocacao.\n");
        return 1;
    }

    
    for (int i = 0; i < quant_dados; i++) {
        printf("Coloque o dado %d para somar: ", i + 1);
        scanf("%d", (vetor + i)); 
        
        soma_vet += *(vetor + i);
    }

    printf("\nA soma deles foi de %d\n", soma_vet);
    printf("Os dados colocados foram: ");
    
    
    for (int i = 0; i < quant_dados; i++) {
        printf("%d ", *(vetor + i));
    }
    printf("\n");

    
    free(vetor);
    vetor = NULL;

    return 0;
}
