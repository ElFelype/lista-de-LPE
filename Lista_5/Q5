#include <stdio.h>
#include <stdlib.h>
#define TAM 10

/*
Contagem de pares e ímpares: Contar quantos números pares e ímpares
existem em um vetor
*/
int main(void)
{
    int par = 0, impar = 0;
    int vetor[TAM] = {1,5,13,6,8,10,9,15,7,6};
    
    int *ptr = vetor;

    for(int i = 0; i<TAM; i++){
        if(*ptr & 1) impar++;
        else par++;
        ptr++;
    }
    printf("par:%d\nimpar:%d", par, impar);
    return 0;
}
