#include <stdio.h>
#define TAM 10
/*
Busca simples: Dado um valor, verificar se ele está presente em um vetor
*/    
int main(void)
{
    int vetor[TAM] = {1,2,54,6,0,7,3,8,9,4};
    int *ptr = vetor;
    int valor = 3;

    for(int i = 0; i<TAM; i++){
        if((*ptr ^ valor) == 0){
            printf("Valor esta no indice %d", i + 1);
            break;
        }
        ptr++;
    }
    return 0;
}
