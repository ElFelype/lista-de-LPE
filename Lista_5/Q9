#include <stdio.h>
#define TAM 10
#define ESCALAR 4
/*
Produto por escalar: Multiplicar todos os elementos de um vetor por uma
constante k
*/    
int main(void)
{
    int vetor[TAM] = {1,2,54,6,0,7,3,8,9,4};
    int *ptr = vetor;
    for (int i = 0; i < TAM; i++) {
        printf("%d ", vetor[i]); 
    }

    for(int i = 0; i<TAM; i++){
        *ptr++ *= ESCALAR;
    }
    printf("\n");
    for (int i = 0; i < TAM; i++) {
        printf("%d ", vetor[i]); 
    }
    return 0;
}
