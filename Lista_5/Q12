#include <stdio.h>
#include <stdlib.h>
#define I 3
#define J 4

/*
Soma dos elementos: Somar todos os valores de uma matriz
*/

int main(void)
{
    int matriz[I][J] = {{1,3,4,5},{3,5,7,2},{8,0,4,9}};
    int *ptr = &matriz[0][0];
    int soma = 0;
    
    for(int i = 0; i<I; i++){        
        for(int j = 0; j<J; j++){
            soma += *ptr++;
        }      
    }
    printf("%d", soma);
    return 0;
}
