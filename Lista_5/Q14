#include <stdio.h>
#define N 3


/*
Diagonal principal: Exibir os elementos da diagonal principal de uma matriz
quadrada
*/

int main(void)
{
    int matriz[N][N] = {{1,3,4},{3,5,7},{8,0,4}};
    int *ptr = &matriz[0][0];
    int salto = N + 1; 
         
    for(int j = 0; j<N; j++){
        printf("%d ", *ptr);
        ptr += salto;            
    }        
       
    return 0;
}
            
