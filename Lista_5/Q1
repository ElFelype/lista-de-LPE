#include <stdio.h>
#include <stdlib.h>
#define NUM 10
/*
Leitura de vetor: Ler um vetor de 10 números e exibir todos os elementos
*/
int main()
{
    int *vetor = (int *)calloc(10, sizeof(int));
    if(vetor == NULL) {printf("ERRO"); return 1;}
    
    for(int i = 0; i < NUM; i++){
        printf("Coloque o dado no vetor %d: ", i+1);
        scanf("%d", &vetor[i]);        
    }
    for(int i = 0; i < NUM; i++){
        printf("%d ", vetor[i]);        
    }
    free(vetor);
    vetor = NULL;
}
