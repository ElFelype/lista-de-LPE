#include <stdio.h>
#define N 3


/*
Soma de colunas: Calcular a soma dos elementos de cada coluna
*/

int main(void)
{
    int matriz[N][N] = {{1,3,4},{3,5,7},{8,0,4}};
    int *ptr = &matriz[0][0];
         
    for(int j = 0; j<N; j++){

        int soma_vet = 0;
        for(int i = 0; i<N; i++){
            soma_vet += *(ptr + ((i*N)+j));
        }
        printf("A soma %d foi de %d.\n", j+1, soma_vet);
    }        
       
    return 0;
}
            
